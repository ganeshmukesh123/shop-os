{
  "name": "@shopos/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder",
    "test": "node scripts/vitest-electron.mjs run",
    "test:e2e": "playwright test",
    "test:e2e:packaged": "node scripts/e2e-packaged.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "ensure:sqlite": "node scripts/ensure-electron-sqlite.mjs",
    "postinstall": "node scripts/ensure-electron-sqlite.mjs",
    "predev": "node scripts/ensure-electron-sqlite.mjs",
    "pretest": "node scripts/ensure-electron-sqlite.mjs",
    "test:watch": "node scripts/vitest-electron.mjs",
    "pretest:e2e": "node scripts/ensure-electron-sqlite.mjs",
    "pretest:coverage": "node scripts/ensure-electron-sqlite.mjs",
    "test:coverage": "node scripts/vitest-electron.mjs run --coverage"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.1.0",
    "better-sqlite3": "^13.1.1",
    "drizzle-orm": "^0.45.4",
    "radix-ui": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@shopos/core": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "drizzle-kit": "^0.31.11",
    "electron": "^43.8.10",
    "electron-builder": "~26.15.7",
    "electron-vite": "^3.1.0",
    "jsdom": "^31.0.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
