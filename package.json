{
  "name": "shop-os",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --filter @shopos/desktop dev",
    "build": "pnpm --filter @shopos/core build && pnpm --filter @shopos/desktop build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @shopos/desktop test:e2e",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "pr:size": "bash scripts/pr-size.sh",
    "test:coverage": "pnpm -r --no-bail --no-sort test:coverage",
    "test:scripts": "node --test \"scripts/ci/*.test.mjs\"",
    "check:migrations": "bash scripts/ci/check-migrations.sh",
    "format:check": "prettier --check \"apps/*/{src,tests,scripts}/**/*.{ts,tsx,mjs}\" \"apps/*/*.{ts,mjs}\" \"packages/*/{src,tests}/**/*.ts\" \"packages/*/*.ts\" \"scripts/**/*.mjs\" \"config/**/*.ts\" \"*.js\" \".github/**/*.yml\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.12"
  }
}
