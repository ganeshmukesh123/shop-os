{
  "name": "shop-os",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --filter @shopos/desktop dev",
    "build": "pnpm --filter @shopos/core build && pnpm --filter @shopos/desktop build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @shopos/desktop test:e2e",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
